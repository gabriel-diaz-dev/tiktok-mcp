# Optional local data/profile directory (default: ~/.tiktok-mcp).
TIKTOK_MCP_DATA_DIR=

# Optional Chrome, Edge, or Brave executable. The MCP auto-detects common paths.
TIKTOK_BROWSER_PATH=

# Optional. Desktop sessions are headed by default.
TIKTOK_HEADLESS=false

# Free ephemeral QR hand-off used by tiktok_connect (no cookies or account data).
TIKTOK_CONNECT_RELAY_URL=https://tiktok.palmyr.ai
